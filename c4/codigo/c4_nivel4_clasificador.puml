@startuml C4_Nivel4_Clasificador_Corregido
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!theme C4_blue from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes

LAYOUT_TOP_DOWN()

title Nivel 4 - Diagrama de Código\nComponente: Clasificador de Señas (Inferencia con Normalización Antropométrica)

' ── Tags ──
AddElementTag("interface", $bgColor="#6366F1", $fontColor="#FFFFFF", $borderColor="#4F46E5", $shape=RoundedBoxShape(), $legendText="Interfaz / Tipo")
AddElementTag("class", $bgColor="#1168BD", $fontColor="#FFFFFF", $borderColor="#0B4884", $legendText="Clase / Módulo")
AddElementTag("function", $bgColor="#059669", $fontColor="#FFFFFF", $borderColor="#047857", $shape=RoundedBoxShape(), $legendText="Función")
AddElementTag("external_lib", $bgColor="#999999", $fontColor="#FFFFFF", $borderColor="#666666", $legendText="Librería externa")

' ── Interfaces / Tipos ──
Component(pose_anchors, "PoseAnchors", "TypeScript Interface", "Interface para anclajes de pose:\n{ nose: Point, left_shoulder: Point, right_shoulder: Point }\nVital para la normalización antropométrica.", $tags="interface")

Component(prediction_output, "PredictionResult", "TypeScript Interface", "Interface que define el resultado:\n{ label: string, confidence: number,\nallProbabilities: Map<string, number> }", $tags="interface")

' ── Clase principal ──
Component(sign_classifier, "SignClassifier", "Clase TypeScript", "Clase singleton que encapsula la lógica de clasificación.\n\nAtributos:\n- session: InferenceSession | null\n- labels: string[]\n- isReady: boolean", $tags="class")

' ── Funciones / Métodos ──
Component(load_model, "loadModel(modelPath: string)", "Método async", "Descarga el archivo .onnx y crea la InferenceSession con backend WebAssembly.", $tags="function")

Component(classify, "classify(landmarks: number[], anchors: PoseAnchors)", "Método async", "Método principal de inferencia:\n1. Valida estado de la sesión\n2. Llama a normalizeLandmarks() usando los anchors\n3. Crea el Tensor de entrada (Float32Array)\n4. Ejecuta session.run()\n5. Procesa la salida con softmax", $tags="function")

Component(normalize, "normalizeLandmarks(raw: number[], anchors: PoseAnchors)", "Método privado", "REGLA CRÍTICA: Espejo de utils.py en Python.\n1. Calcula la distancia entre hombros (anchors) como factor de escala.\n2. Centra los landmarks respecto al punto medio de los hombros o nariz.\n3. Escala los 21 puntos por el factor antropométrico para garantizar invarianza a la distancia de la cámara.", $tags="function")

Component(softmax, "applySoftmax(logits: number[])", "Método privado", "Convierte logits a probabilidades para obtener el score de confianza.", $tags="function")

' ── Librería externa ──
Component(onnx_lib, "onnxruntime-web", "Librería npm", "Runtime para ejecutar el modelo .onnx en el navegador.", $tags="external_lib")

' ── Relaciones ──
Rel_D(sign_classifier, load_model, "Inicialización")
Rel_D(sign_classifier, classify, "Ejecución por frame")
Rel_D(classify, normalize, "Preprocesamiento (Sync con entrenamiento)")
Rel_D(classify, softmax, "Post-procesamiento")
Rel_D(load_model, onnx_lib, "Carga sesión")
Rel_D(classify, onnx_lib, "Inferencia")
Rel_U(pose_anchors, normalize, "Usa para escalar coordenadas")
Rel_U(prediction_output, classify, "Retorna")

SHOW_LEGEND()

@enduml